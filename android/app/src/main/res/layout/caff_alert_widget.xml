<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/caff_widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/caff_widget_background"
    android:contentDescription="@string/caff_widget_default_description"
    android:gravity="center_vertical"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:id="@+id/caff_widget_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/caff_widget_title"
        android:textAllCaps="true"
        android:textColor="#E6B980"
        android:textSize="12sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/caff_widget_level"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:text="@string/caff_widget_default_level"
        android:textColor="#FFF8EE"
        android:textSize="25sp"
        android:textStyle="bold" />

    <ProgressBar
        android:id="@+id/caff_widget_progress"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="7dp"
        android:layout_marginTop="10dp"
        android:indeterminate="false"
        android:max="100"
        android:progress="0"
        android:progressBackgroundTint="#5A392A"
        android:progressTint="#D88A42" />

    <TextView
        android:id="@+id/caff_widget_status"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="@string/caff_widget_empty"
        android:textColor="#EADDD0"
        android:textSize="13sp" />
</LinearLayout>
