<?xml version="1.0" encoding="utf-8"?>
<!-- 4×2 (default size): ring on the left; status, when CAF hits zero (small
     label + IBM Plex Mono time) and "+ Coffee" on the right. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/caff_widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/caff_widget_background"
    android:padding="10dp"
    android:gravity="center_vertical"
    android:orientation="horizontal">
    <ImageView
        android:id="@+id/caff_widget_ring"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="0.47"
        android:scaleType="fitCenter"
        android:src="@drawable/caff_widget_preview_ring"
        android:contentDescription="@string/caff_widget_default_description" />
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="0.53"
        android:layout_marginStart="10dp"
        android:gravity="center_vertical"
        android:orientation="vertical">
        <TextView
            android:id="@+id/caff_widget_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/caff_widget_state_empty"
            android:textColor="#F4E9DE"
            android:textSize="15sp"
            android:textStyle="bold"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:ellipsize="end" />
        <TextView
            android:id="@+id/caff_widget_end_label"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/caff_widget_empty"
            android:textColor="#D7BBA7"
            android:textSize="12sp"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:ellipsize="end" />
        <TextView
            android:id="@+id/caff_widget_end_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:fontFamily="@font/ibm_plex_mono_bold"
            android:textColor="#FFFBF7"
            android:textSize="20sp"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:visibility="gone" />
        <TextView
            android:id="@+id/caff_widget_add"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:layout_marginTop="8dp"
            android:minWidth="88dp"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:background="@drawable/caff_widget_button"
            android:gravity="center"
            android:text="@string/caff_widget_add"
            android:contentDescription="@string/caff_widget_add_description"
            android:textColor="#35241D"
            android:textSize="13sp"
            android:textStyle="bold"
            android:maxLines="1" />
    </LinearLayout>
</LinearLayout>
